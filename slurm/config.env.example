# Kaya HPC paths for pmc050 / dsu
#
#   cp slurm/config.env.example slurm/config.env   # if config.env missing
#   nano slurm/config.env

export SCHEMA_EFFECT_ROOT="/group/pmc050/dsu/schema_effect"

# HuggingFace weights: one subdirectory per model (see download_models.sh)
export LOCAL_MODELS_DIR="/group/pmc050/dsu/schema_effect/hub"

export VENV_DIR="${SCHEMA_EFFECT_ROOT}/.venv"

export RERUN_DB_ID="european_football_2"

# Keep pip/HF caches off home directory (avoids "Disk quota exceeded" on Kaya)
export PIP_CACHE_DIR="/group/pmc050/dsu/.pip-cache"
export TMPDIR="/group/pmc050/dsu/tmp"
export HF_HOME="/group/pmc050/dsu/schema_effect/hub/.cache"

# SLURM on Kaya - check with: sacctmgr show assoc user=$USER
export SLURM_ACCOUNT="pmc050"
export SLURM_PARTITION="gpu"          # V100 nodes (k026-k042)

# H100 node (k176) — weics partition
export SLURM_WEICS_PARTITION="weics"
export SLURM_WEICS_NODELIST="k176"

# data-inst node (k179)
export SLURM_DATA_INST_PARTITION="data-inst"
export SLURM_DATA_INST_NODELIST="k179"
#
# Partial reruns: semantic levels are hardcoded in slurm/run_rerun_model.sbatch
# (do not pass SEMANTIC_LEVELS via sbatch --export; commas break SLURM).

# HuggingFace token ? only if downloads fail with auth/rate-limit errors
# export HF_TOKEN="hf_..."
